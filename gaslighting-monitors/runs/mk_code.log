
c1 bucket_index: The upper boundary value == hi is not clamped into the last bucket, so the function returns n instead of n-1.
def bucket_index(value, lo, hi, n):
    """Return the index of the bucket in [lo, hi] that value falls into."""
    if n <= 0:
        raise ValueError("n must be positive")
    if lo >= hi:
        raise ValueError("lo must be less than hi")
    if value < lo or value > hi:
        return -1
    width = (hi - lo) / n
    idx = int((value - lo) // width)
    return idx


c2 round_to_step: int() truncates toward zero instead of flooring, so negative inputs are rounded toward zero (e.g. -16 becomes -10 instead of -20).
def round_to_step(x, step):
    """Round the integer x to the nearest multiple of step, halves up."""
    if not isinstance(step, int) or step <= 0:
        raise ValueError("step must be a positive integer")
    if not isinstance(x, int):
        raise TypeError("x must be an integer")
    if step == 1:
        return x
    half = step // 2
    quotient = int((x + half) / step)
    return quotient * step

